#!/usr/bin/env bash
set -euo pipefail

# 运行 ROS 2 Python 脚本：基础环境 + 本工作区 overlay。
# 用法：./scripts/ros <script.py> 或 ./scripts/ros -m pytest
PYTHON="$HOME/.venvs/ros-humble/bin/python"
WS="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"

unset PYTHONPATH PYTHONHOME VIRTUAL_ENV PYTEST_PLUGINS
export PYTHONNOUSERSITE=1
# 优先使用本机统一机器人入口；新机器也可直接使用标准 Humble 安装。
runner=(bash --noprofile --norc -c 'source /opt/ros/humble/setup.bash; exec "$@"' _)
if command -v robot-tools >/dev/null 2>&1; then
  runner=(robot-tools ros)
fi
exec "${runner[@]}" bash --noprofile --norc -c '
  set -e
  if [[ -f "$1" ]]; then
    source "$1"
  fi
  shift
  exec "$@"
' _ "$WS/install/setup.bash" "$PYTHON" "$@"
